<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Instrumented contacts fixture only; the production tool never writes. -->
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <application>
        <!-- Only adb shell/system callers may open diagnostic or provisioning entry points. -->
        <receiver android:name=".debug.DebugReceiver" android:exported="true" android:permission="android.permission.DUMP" />
        <activity android:name=".debug.ProbeActivity" android:exported="true" android:permission="android.permission.DUMP" android:label="Misura probe" />
        <activity android:name=".debug.ExperimentActivity" android:exported="true" android:permission="android.permission.DUMP" android:label="Misura experiment" />
        <activity android:name=".debug.HiddenScreenProbeActivity" android:exported="true" android:permission="android.permission.DUMP" android:label="Misura hidden screen" />
    </application>
</manifest>
