<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Debug-only fixture for the shortcut launcher tests: a receiver that publishes dynamic shortcuts, and the (non-exported) page they open. -->
    <application>
        <activity android:name=".FixtureTargetActivity" android:exported="false" />
        <!-- Decoy: handles spotify: VIEW and records it. A launcher that loses setPackage would open this instead of refusing (Spotify is absent). -->
        <activity android:name=".DecoyLinkActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="spotify" />
            </intent-filter>
        </activity>
        <receiver android:name=".ShortcutControl" android:exported="true">
            <intent-filter><action android:name="com.misura.testapp.SHORTCUTS" /></intent-filter>
        </receiver>
    </application>
</manifest>
